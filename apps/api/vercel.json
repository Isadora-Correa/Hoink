{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build && pnpm prisma:deploy && mkdir -p public",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{dist/**,assets/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [{ "path": "/cron/daily", "schedule": "0 9 * * *" }]
}
