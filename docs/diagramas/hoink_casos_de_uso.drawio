<mxfile host="app.diagrams.net" agent="hoink-diagrams" version="24.7.17"><diagram name="Casos de Uso" id="Casos_de_Uso"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="2400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Sistema hoink. — Gestão Financeira PF/PJ" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=none;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="260" y="20" width="520" height="1432" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;RF01 – Gestão de acesso&lt;/b&gt;&lt;br&gt;&lt;b&gt;Cadastro, login, recuperar/trocar senha, sessões&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="360.0" y="90" width="320" height="64" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;RF02 – Gerenciar ambientes&lt;/b&gt;&lt;br&gt;&lt;b&gt;Pessoal, Profissional e visão Consolidada&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="360.0" y="194" width="320" height="64" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;RF03 – Gestão de lançamentos&lt;/b&gt;&lt;br&gt;&lt;b&gt;Contas, categorias, receitas, despesas, reembolsos, ajustes&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="360.0" y="298" width="320" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;RF04 – Liquidar lançamento&lt;/b&gt;&lt;br&gt;&lt;b&gt;Liquidação parcial/total e cálculo de saldos&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="360.0" y="402" width="320" height="64" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;RF05 – Realizar transferência&lt;/b&gt;&lt;br&gt;&lt;b&gt;Entre contas e PF ↔ PJ, com classificação gerencial&lt;/b&gt;" style="ellipse;whi