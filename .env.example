# Copie para .env e ajuste. NUNCA versione o .env com credenciais reais.

# ── API ──
NODE_ENV=development
PORT=3333
# Banco local do docker-compose (credenciais apenas de desenvolvimento).
DATABASE_URL=postgresql://hoink:hoink@localhost:5433/hoink
# Origens permitidas para CORS em produção (URL pública do front), separadas por vírgula.
CORS_ORIGINS=
SESSION_TTL_DAYS=30
APP_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=info
APP_VERSION=0.1.0
# Tentativas de autenticação por IP a cada 15 minutos.
AUTH_RATE_LIMIT=20
# Opcional: protege GET /metrics com "Authorization: Bearer <token>".
METRICS_TOKEN=

# ── Docker Compose ──
# Porta do front-end no host (mude se a 8080 estiver ocupada).
WEB_PORT=8080

# Índices (CDI, Selic, IPCA) do Banco Central — API pública, sem chave. false = só taxas manuais.
MARKET_DATA_SYNC=true
# Opcional: permite lançar índices manualmente via PUT /api/market-rates (cabeçalho X-Admin-Token). Mín. 16 caracteres.
# ADMIN_TOKEN=
